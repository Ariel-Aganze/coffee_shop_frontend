# Copy to `.env.local` and adjust. Never commit real values (.env* is git-ignored).
#
# Variables prefixed with VITE_ are embedded in the browser bundle — they are
# PUBLIC. Never put secrets in them.

# Base URL of the Django API as seen by the browser.
# Keep `/api` in development (Vite proxies it) and when the frontend is served
# from the same domain as the API in production. Use a full URL
# (https://api.example.com/api) only if the API lives on another domain.
VITE_API_BASE_URL=/api

# Product name shown in the UI and page titles.
VITE_APP_NAME=Caffio

# --- Development only (not exposed to the browser) ---
# Where `npm run dev` forwards /api and /media requests.
API_PROXY_TARGET=http://localhost:8000
# Where `npm run api:types` downloads the OpenAPI schema from.
API_SCHEMA_URL=http://localhost:8000/api/schema/
